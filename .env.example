# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Your existing AI email generation API
REACT_APP_AI_API_URL=http://localhost:8000

# Microsoft Azure App Registration
# Create at: https://portal.azure.com → Azure Active Directory → App registrations
# Required permissions: Mail.ReadWrite, Mail.Send (delegated)
REACT_APP_MS_CLIENT_ID=your-azure-app-client-id-here
REACT_APP_MS_REDIRECT_URI=http://localhost:3000/auth/callback
